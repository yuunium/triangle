{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nanakaku",
  "account_id": "a3b8b5dbd5db2069949866961fe7df5d",
  "main": "cloudflare/index.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sankaku-ranking",
      "database_id": "f0c166b7-0da0-4eae-96c9-b4918b992265",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "READ_LIMITER",
      "namespace_id": "27102901",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "27102902",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
